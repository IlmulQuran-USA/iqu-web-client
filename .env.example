# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# In Vercel, set these under Project › Settings › Environment Variables (DEPLOYMENT.md).

# --- Site environment -------------------------------------------------------
# "production" only on the real public site. Anything else, including leaving it
# unset, is staging: every page carries <meta name="robots" content="noindex, nofollow">,
# every response sends X-Robots-Tag: noindex, nofollow, and no sitemap is served
# (src/lib/site-env.ts). robots.txt allows crawling everywhere, so link previews work.
# Read at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_ENV=

# The site's origin, for canonical URLs and Open Graph links (metadataBase).
# Staging: https://dev.ilmulquranus.org · production later: https://ilmulquranus.org
# If unset, it falls back to the origin for NEXT_PUBLIC_SITE_ENV. Read at build time.
NEXT_PUBLIC_SITE_URL=

# --- Brevo newsletter ---------------------------------------------------------
# Read on the server only (src/lib/server/brevo.ts); none reaches the browser.
# If any of the four is missing, the footer shows "Sign-up opens soon." instead of a form.

# Brevo API key (Settings › SMTP & API › API keys)
BREVO_API_KEY=
# Numeric id of the newsletter list the contact joins after confirming
BREVO_LIST_ID=
# Numeric id of the double opt-in confirmation template
BREVO_DOI_TEMPLATE_ID=
# Page shown after the person clicks the confirmation link (https://…)
BREVO_REDIRECT_URL=

# Optional, for tests only: point the client at a local mock instead of https://api.brevo.com/v3
# BREVO_API_URL=

# --- Online enrollment (/enroll → iqu-registration plugin) -----------------
# Read on the server only (src/lib/server/enroll-wp.ts); none reaches the browser
# except RECAPTCHA_SITE_KEY, which the page passes to the reCAPTCHA script.
# If any of the four is missing, /enroll still works and saves progress on the
# family's device, but Review links to the live WordPress form instead of
# submitting. Nothing is ever faked.

# https URL of the plugin's POST /wp-json/iqu/v1/enroll (sub-routes /coupon, /waitlist hang off it)
IQU_WP_ENDPOINT=
# Shared HMAC secret, at least 32 characters; the same value as the plugin's IQU_NEXT_HMAC_SECRET
IQU_NEXT_HMAC_SECRET=
# reCAPTCHA v3 keys registered for the Next hosts (dev.ilmulquranus.org, ilmulquranus.org)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional, for tests only: point the server at a local mock instead of Google
# RECAPTCHA_VERIFY_URL=

# --- Enrollment on Next.js (owner, 24 Nov 2026; F:/iqu-setup/reports/enroll-next-native-architecture.md) ---
# Server only unless the name starts with NEXT_PUBLIC_. Never commit values.
# dev.ilmulquranus.org, previews and local use TEST keys, a TEST Telegram chat and a TEST
# mail allow-list only. Live keys and the team chat belong to the real domain alone;
# src/lib/server/stripe-mode.ts refuses live Stripe keys unless NEXT_PUBLIC_SITE_ENV=production.
# IQU_WP_ENDPOINT and IQU_NEXT_HMAC_SECRET above belong to the retired WordPress-backend plan
# (Option A) and go away when P1 replaces the transport.

# Postgres (Neon, set by the Vercel Marketplace integration per environment: staging / dev / preview branches)
DATABASE_URL=

# Stripe (P2; test keys everywhere except the production site)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram (same bot; dev uses a TEST chat id, never the team chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail API with OAuth (gmail.send) for transactional and contact-form email, from the same
# account as today. Dev: a test account, and only addresses in EMAIL_ALLOWLIST receive mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
EMAIL_ALLOWLIST=

# Clerk (admin /a/* now; the student, parent and teacher portal later)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
