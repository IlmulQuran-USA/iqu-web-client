# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# All are read on the server only (src/lib/server/brevo.ts); none reaches the browser.
# If any of the four is missing, the footer shows "Sign-up opens soon." instead of a form.

# Brevo API key (Settings › SMTP & API › API keys)
BREVO_API_KEY=
# Numeric id of the newsletter list the contact joins after confirming
BREVO_LIST_ID=
# Numeric id of the double opt-in confirmation template
BREVO_DOI_TEMPLATE_ID=
# Page shown after the person clicks the confirmation link (https://…)
BREVO_REDIRECT_URL=

# Optional, for tests only: point the client at a local mock instead of https://api.brevo.com/v3
# BREVO_API_URL=
